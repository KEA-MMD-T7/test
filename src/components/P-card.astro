---
const { product } = Astro.props;
---

<a href={"single/" + product.id} class={product.layout}>
  <article>
    <img src={product.image} alt={product.imagedescr} />
    <h2>{product.name}</h2>
    <p>kr. {product.price},-</p>
  </article>
</a>

<style>
  article {
    padding: 1rem;
    background-color: #ded;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  .layout1 {
    text-align: left;
    color: red;
  }
  .layout2 {
    text-align: right;
    color: green;
  }
  .layout3 {
    text-align: center;
    color: blue;
  }
</style>
