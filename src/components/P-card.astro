---
const { product } = Astro.props;
---

<a href={"single/" + product.id} class={product.category}>
  <article>
    <img
      src=`https://flxrgxrvxeximsskwubc.supabase.co/storage/v1/object/public/products/images/${product.image}`
      alt={product.imagedescr}
    />
    <h2>{product.name}</h2>
    <p>kr. {product.price},-</p>
  </article>
</a>

<style>
  article {
    padding: 1rem;
    background-color: rgb(236, 236, 236);
    background-image: url(../assets/background.svg);
    background-size: cover;
  }
  a {
    text-decoration: none;
    color: inherit;
  }
  .cap {
    text-align: left;
    color: red;
  }
  .shirt {
    text-align: right;
    color: green;
  }
  .pants {
    text-align: center;
    color: blue;
  }
</style>
